
RewriteEngine On

# ==========================================
# 1. Redirect old solution URLs
# Only redirect direct browser requests
# ==========================================
RewriteRule ^contact-submit\.php$ - [L,NC]
RewriteCond %{THE_REQUEST} \s/+(?:automotive-incentive|dealer-competitive-intelligence|automotive-pricing-intelligence)(?:\.php)?[?\x20] [NC]
RewriteRule ^(automotive-incentive|dealer-competitive-intelligence|automotive-pricing-intelligence)(\.php)?$ /solutions/$1 [R=301,L,NC,NE]

# ==========================================
# 2. Redirect other PHP URLs
# Only when explicitly requested
# ==========================================

RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php(?:[?\x20]) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]


# ==========================================
# 3. Preserve existing static files
# CSS, JS, images, fonts
# ==========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ==========================================
# 4. SEO-friendly blog URLs
# ==========================================

RewriteRule ^blog/([a-z0-9-]+)/?$ blog.php?slug=$1 [L,QSA,NC]


# ==========================================
# 5. SEO-friendly solution URLs
# Internal rewrite without redirect
# ==========================================

# Internally load solution PHP files
RewriteRule ^solutions/(automotive-incentive|dealer-competitive-intelligence|automotive-pricing-intelligence)/?$ $1.php [L,NC]

# ==========================================
# 6. Extensionless PHP pages
# ==========================================

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L,QSA]
