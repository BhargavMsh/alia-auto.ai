PROJECT_ROOT = Path(__file__).resolve().parent.parent


# ============================================================
# ENVIRONMENT HELPER
# ============================================================

def required_env(name: str) -> str:
    value = os.getenv(name, "").strip()

    if not value:
        raise RuntimeError(
            f"Missing environment variable: {name}"
        )

    return value


# ============================================================
# EMBED ALIA LOGO INTO HTML EMAIL
# ============================================================

def embed_alia_logo(message: EmailMessage) -> None:
    """
    Embeds the ALIA logo using CID so the recipient's
    email client does not need access to our website
    to display the image.
    """

    logo_path = (
        PROJECT_ROOT
        / "assets"
        / "images"
        / "alia-logo.png"
    )

    if not logo_path.exists():
        return

    with logo_path.open("rb") as logo_file:
        logo_data = logo_file.read()

    payload = message.get_payload()

    if not isinstance(payload, list) or not payload:
        return

    # The HTML alternative is the latest MIME part.
    html_part = payload[-1]

    html_part.add_related(
        logo_data,
        maintype="image",
        subtype="png",
        cid="<alia-logo>",
        filename="alia-logo.png",
        disposition="inline",
    )


# ============================================================
# MAIN CONTACT EMAIL FUNCTION
# ============================================================

def send_contact_email(
    *,
    name: str,
    phone: str,
    email: str,
    purpose: str,
) -> None:

    # ========================================================
    # AWS SES SMTP CONFIGURATION
    # ========================================================

    smtp_host = required_env(
        "ALIA_SES_SMTP_HOST"
    )

    smtp_port = int(
        os.getenv(
            "ALIA_SES_SMTP_PORT",
            "587",
        )
    )

    smtp_username = required_env(
        "ALIA_SES_SMTP_USERNAME"
    )

    smtp_password = required_env(
        "ALIA_SES_SMTP_PASSWORD"
    )

    from_email = required_env(
        "ALIA_CONTACT_FROM_EMAIL"
    )

    from_name = os.getenv(
        "ALIA_CONTACT_FROM_NAME",
        "ALIA",
    ).strip()

    support_email = required_env(
        "ALIA_CONTACT_TO_EMAIL"
    )

    support_name = os.getenv(
        "ALIA_CONTACT_TO_NAME",
        "ALIA Support",
    ).strip()


    # ========================================================
    # ESCAPE VALUES FOR HTML DISPLAY
    # ========================================================

    safe_name = html.escape(name)

    safe_phone = html.escape(phone)

    safe_email = html.escape(email)

    safe_purpose = html.escape(
        purpose
    ).replace(
        "\n",
        "<br>",
    )

    submitted_at = datetime.now(
        timezone.utc
    ).strftime(
        "%d %b %Y, %H:%M UTC"
    )

    current_year = datetime.now().year


    # ========================================================
    # EMAIL 1
    # INTERNAL ALIA NOTIFICATION
    # ========================================================

    internal_message = EmailMessage()

    internal_message["Subject"] = (
        f"[ALIA] New Website Enquiry - {name}"
    )

    internal_message["From"] = formataddr(
        (
            from_name,
            from_email,
        )
    )

    internal_message["To"] = formataddr(
        (
            support_name,
            support_email,
        )
    )

    # When ALIA team clicks Reply,
    # reply directly to the customer.
    internal_message["Reply-To"] = email


    # --------------------------------------------------------
    # INTERNAL EMAIL - PLAIN TEXT FALLBACK
    # --------------------------------------------------------

    internal_plain_text = f"""
ALIA — Auto Offers Live Intelligent Agent
Confidence in Every Car Deal

NEW WEBSITE ENQUIRY

A new enquiry has been submitted through the ALIA website.

Name:
{name}

Phone:
{phone}

Email:
{email}

Purpose of Visit:
{purpose}

Submitted:
{submitted_at}

Website:
https://alia-auto.ai/

Markets:
UAE · KSA · Qatar · Kuwait

---
ALIA
Auto Offers Live Intelligent Agent
Confidence in Every Car Deal
""".strip()

    internal_message.set_content(
        internal_plain_text
    )


    # --------------------------------------------------------
    # INTERNAL EMAIL - HTML
