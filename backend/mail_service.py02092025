"""

    acknowledgement_message.add_alternative(
        acknowledgement_html,
        subtype="html",
    )

    embed_alia_logo(
        acknowledgement_message
    )


    # ========================================================
    # SEND BOTH EMAILS USING ONE AWS SES SMTP CONNECTION
    # ========================================================

    context = ssl.create_default_context()

    with smtplib.SMTP(
        smtp_host,
        smtp_port,
        timeout=30,
    ) as smtp:

        smtp.ehlo()

        smtp.starttls(
            context=context
        )

        smtp.ehlo()

        smtp.login(
            smtp_username,
            smtp_password,
        )


        # ----------------------------------------------------
        # EMAIL 1:
        # Internal ALIA notification
        # ----------------------------------------------------

        print(
            f"[ALIA MAIL] Sending internal email to: {support_email}",
            file=sys.stderr,
            flush=True,
        )

        internal_result = smtp.send_message(
            internal_message
        )

        print(
            f"[ALIA MAIL] Internal send result: {internal_result}",
            file=sys.stderr,
            flush=True,
        )


        # ----------------------------------------------------
        # EMAIL 2:
        # Customer acknowledgement
        # ----------------------------------------------------

        print(
            f"[ALIA MAIL] Sending acknowledgement to: {email}",
            file=sys.stderr,
            flush=True,
        )

        try:
            acknowledgement_result = smtp.send_message(
                internal_message
            )

            print(
                (
                    "[ALIA MAIL] Customer acknowledgement "
                    f"send result: {acknowledgement_result}"
                ),
                file=sys.stderr,
                flush=True,
            )

        except Exception as exc:
            print(
                (
                    "[ALIA MAIL] CUSTOMER ACKNOWLEDGEMENT FAILED: "
                    f"{type(exc).__name__}: {exc}"
                ),
                file=sys.stderr,
                flush=True,
            )

            raise